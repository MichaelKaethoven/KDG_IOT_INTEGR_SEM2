# Copy to .env and fill in values before running middleware.py or Docker.

# Optional: POST location data to this URL on every poll cycle
PUSH_URL=

# Seconds between polls (minimum 300 — Google's unofficial floor)
POLL_INTERVAL=300

# Port for the Flask /devices endpoint
PORT=5500

# Supabase — leave blank to disable DB push
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=
