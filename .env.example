# Copy to .env and fill in values before running middleware.py or Docker.

# Seconds between polls (minimum 300 — Google's unofficial floor)
POLL_INTERVAL=300

# Port for the Flask /devices endpoint
PORT=5500

# MQTT broker — required for publishing and subscribing
# Sign up at https://www.hivemq.com/mqtt-cloud-broker/ for a free cluster
MQTT_HOST=<your-cluster>.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=findmy/devices

# Supabase — used by subscriber.py to store historical location data
# Leave blank to disable DB writes
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=

# Supabase PostgreSQL direct connection — used by Grafana datasource
# Find the password under Supabase > Settings > Database > Connection string
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_USER=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=

# Customer portal webapp (port 8080)
WEBAPP_PORT=8080
SECRET_KEY=change-me-to-a-random-string
# Generate hashes: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
ADMIN_PASSWORD_HASH=
USER_PASSWORD_HASH=

# URL Grafana is reachable at from the browser (for iframe embed)
GRAFANA_URL=http://localhost:3000

# Middleware URL the webapp calls for /devicelist (tracker sync). In docker
# this is the internal service name; for local dev set to http://localhost:5500.
MIDDLEWARE_URL=http://middleware:5500

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=admin
