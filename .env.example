# Copy to .env and fill in values before running middleware.py or Docker.

# Seconds between polls (minimum 300 — Google's unofficial floor)
POLL_INTERVAL=300

# Per-poll location fetching is batched to avoid Google rate limits.
# LOCATION_BATCH_SIZE devices are requested in parallel per batch (5–10 is safe),
# with LOCATION_BATCH_DELAY seconds of pause between batches, and
# LOCATION_TIMEOUT seconds waited for each device's response.
# These are the defaults for the portal Settings page; once an admin saves
# values there (stored in the app_settings table) those override these.
LOCATION_BATCH_SIZE=8
LOCATION_BATCH_DELAY=2.0
LOCATION_TIMEOUT=30

# Port for the Flask /devices endpoint
PORT=5500

# MQTT broker — required for publishing and subscribing
# Sign up at https://www.hivemq.com/mqtt-cloud-broker/ for a free cluster
MQTT_HOST=<your-cluster>.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=findmy/devices

# Supabase — used by subscriber.py to store historical location data
# Leave blank to disable DB writes
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=

# Supabase PostgreSQL direct connection — used by Grafana datasource
# Find the password under Supabase > Settings > Database > Connection string
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_USER=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=

# Customer portal webapp (port 8080)
WEBAPP_PORT=8080
# REQUIRED — generate a strong random key (32+ bytes). The app refuses to start
# in production if this is short or starts with "change-me".
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
# Set the session cookie's Secure flag (HTTPS-only). Default true. Set to false
# only when running locally over plain HTTP, otherwise the session cookie will
# not be sent back and login appears to silently fail.
SESSION_COOKIE_SECURE=true
# Hours without a ping before a tracker is flagged stale (red) in the Trackers list
TRACKER_STALE_HOURS=24
# Generate hashes: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
ADMIN_PASSWORD_HASH=
USER_PASSWORD_HASH=
# Staff login identifiers. Staff sign in with these on the login page (or leave
# the field blank, which still works). Compared case-insensitively; they take
# precedence over any customer login_id, so keep them reserved for staff.
ADMIN_LOGIN_ID=admin@demo.local
USER_LOGIN_ID=user@demo.local

# Grafana is NOT exposed to the browser directly. The webapp reverse-proxies it
# under /grafana (login-gated). GRAFANA_INTERNAL_URL is how the webapp reaches
# Grafana on the private/compose network.
GRAFANA_INTERNAL_URL=http://grafana:3000
# Public base URL of the webapp itself — used to build Grafana's server root URL
# (GF_SERVER_ROOT_URL = <this>/grafana/). For local dev the default is fine.
WEBAPP_PUBLIC_URL=http://localhost:8080

# Middleware URL the webapp calls for /devicelist (tracker sync). In docker
# this is the internal service name; for local dev set to http://localhost:5500.
MIDDLEWARE_URL=http://middleware:5500

# Shared secret guarding the middleware /devices and /devicelist endpoints (live
# geolocation). Set the SAME value on the middleware and the webapp. Generate:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank only for local dev where the middleware is bound to localhost.
DEVICE_API_TOKEN=

# Grafana admin password — REQUIRED, no default. Generate a strong value:
# python -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_PASSWORD=
